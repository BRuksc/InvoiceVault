.ntvs_analysis.dat
node_modules/

# Visual Studio 6 build log
*.plg

# Visual Studio 6 workspace options file
*.opt

# Visual Studio 6 auto-generated workspace file
*.vbw

# Local History for Visual Studio
.vs/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Linux files
*~

# JetBrains Rider data
.idea/

# Azure Functions
local.settings.json

# Publish profiles
*.pubxml
*.publishproj

# Backup & Report files
*.bak
*.backup
*.log
*.rdl.data
*.rptproj.rsuser

# Other generated files
Generated_*/
GeneratedCode/

# Paket dependency manager
.paket/
paket-files/

# FAKE - F# Make
.fake/

# Python artifacts (if using Python scripts)
__pycache__/
*.pyc

# DotCover
.idea/.idea.DotSettings.user

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# User-specific files (Mono Auto Save)
*.mdb

# JetBrains Rider project settings
.idea/
*.sln.iml

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# DotNet tool restore
.dotnet-tools.json

# Coverlet coverage reports
coverage*.json
coverage*.xml
coverage*.info

# Visual Studio local history
.vshistory/

# Temporary ASP.NET files
aspnet_client/
temp/

# Local test coverage results
TestResults/

# NuGet packages
*.nupkg
*.snupkg
# Exclude packages folder if present (not recommended for CI)
# packages/

# Publish output
publish/
wwwroot/dist/
wwwroot/lib/
wwwroot/node_modules/

# Cache
*.cache
*.bak
*.orig
*.tmp
